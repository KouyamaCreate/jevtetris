# Jev provider selection: auto, typesafe, vercel, openrouter, or cloudflare.
# auto checks configured providers in this order: TypeSafe, Vercel, OpenRouter, Cloudflare.
JEV_PROVIDER=auto

# TypeSafe direct (official API). Use either key name; the first non-empty one wins.
# https://typesafe.ai/
TYPESAFE_AI_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_AI_BASE_URL=https://api.typesafe.ai/v1

# Vercel AI Gateway. Vercel deployments can also use VERCEL_OIDC_TOKEN automatically.
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

# OpenRouter Decisions API.
# https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Cloudflare AI Gateway / Workers AI REST API.
# CLOUDFLARE_API_KEY is accepted as a compatibility alias; API tokens are preferred.
# https://developers.cloudflare.com/ai-gateway/usage/rest-api/
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_JEV_MODEL=typesafe/jev
